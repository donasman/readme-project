root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{java,gradle}]
indent_style = tab
indent_size = 4

[*.bat]
end_of_line = crlf

# Windows PowerShell 5.1 은 BOM 이 없으면 한글을 깨뜨려 읽는다.
[*.ps1]
charset = utf-8-bom

[*.md]
trim_trailing_whitespace = false
