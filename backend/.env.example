# 운영 서버에 넣는 환경 변수 목록. 실제 값은 git 에 올리지 않는다.
# 서버에서는 /etc/readme/readme.env 에 두고 systemd 가 읽는다(deploy/readme-api.service).
SPRING_PROFILES_ACTIVE=prod

DB_URL=jdbc:postgresql://HOST:5432/postgres?currentSchema=readme
DB_USERNAME=
DB_PASSWORD=

FRONTEND_ORIGIN=https://app.example.com
CSRF_COOKIE_DOMAIN=example.com

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=리드미 <no-reply@example.com>

# 구글 로그인. Google Cloud 의 OAuth 클라이언트(웹 애플리케이션) 값. docs/리드미_설계_로그인.md 6.1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 공고 링크를 받을 때 User-Agent 에 붙는 연락처(ReadmeFetcher/1.0 (+여기)). 사이트 운영자가 로그인 없이 열어 볼 수 있는
# 공개 페이지나 mailto: 주소를 ASCII 로 쓴다. 출시 전에 실제로 받는 연락처로 바꾼다
FETCHER_CONTACT=mailto:fetcher@example.com

# Claude API 키. Console(platform.claude.com)의 운영용 작업공간에서 만든 키. 비우면 서버가 뜨지 않는다.
# 작업공간에 한 달 사용 한도를 걸어 둔다(사용자마다의 한도는 서버가 따로 본다). docs/리드미_설계_경험카드.md 4.5
ANTHROPIC_API_KEY=
