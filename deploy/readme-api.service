# 초안. /etc/systemd/system/readme-api.service 로 복사해 쓴다.
#   sudo systemctl daemon-reload && sudo systemctl enable --now readme-api
# 비밀 값은 /etc/readme/readme.env 에 둔다(backend/.env.example 의 목록, 권한 600).
[Unit]
Description=Readme API (Spring Boot)
After=network-online.target
Wants=network-online.target

[Service]
User=readme
Group=readme
WorkingDirectory=/opt/readme
EnvironmentFile=/etc/readme/readme.env
# 2GB 서버 기준. 서버 크기를 바꾸면 -Xmx 도 같이 본다. 자료(PDF·HWP)를 읽는 프로세스가 따로 256MB 씩 두 개까지 뜬다.
# 메모리가 모자라면 반쯤 죽은 채로 남지 않고 끝나서 아래의 Restart 로 다시 뜬다.
ExecStart=/usr/bin/java -Xmx768m -XX:+ExitOnOutOfMemoryError -jar /opt/readme/readme-backend.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
# 진행 중인 요청을 마치고 내려가는 시간(Spring Boot 기본 30초)보다 길게 둔다
TimeoutStopSec=40

[Install]
WantedBy=multi-user.target
